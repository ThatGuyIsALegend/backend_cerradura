APP_NAME=Smart Face Lock
APP_VERSION=1.0.0
DEBUG=false
SECRET_KEY=replace-with-a-long-random-secret
DEVICE_API_KEY=replace-with-a-long-random-device-key
CORS_ORIGINS=*
FACE_MATCH_THRESHOLD=0.45
MAX_IMAGE_SIZE_BYTES=5242880

# Credenciales locales de PostgreSQL para Compose. Cámbialas en despliegues reales.
POSTGRES_DB=face_lock
POSTGRES_USER=face_lock
POSTGRES_PASSWORD=change-this-local-password
API_PORT=8000
